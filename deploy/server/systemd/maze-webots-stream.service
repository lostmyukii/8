[Unit]
Description=Maze Webots browser streaming simulation
After=network.target
Conflicts=maze-webots-desktop.service maze-webots-headless.service

[Service]
Type=simple
User=maze
Group=maze
WorkingDirectory=/srv/maze/current
Environment=HOME=/home/maze
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MAZE_SIM_HOST=127.0.0.1
Environment=MAZE_SIM_PORT=8765
Environment=MAZE_PHYSICAL_PROFILE_DIR=/srv/maze/current/simulation/webots/maze_car/config/physical_profiles
Environment=MAZE_DEFAULT_PHYSICAL_PROFILE=normal-v1
Environment=MAZE_PHYSICAL_PROFILE_ID=normal-v1
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1600x900x24" /usr/local/bin/webots --batch --stdout --stderr --mode=realtime --port=1234 --stream=w3d /srv/maze/current/simulation/webots/maze_car/worlds/maze_physical_world.wbt
Restart=on-failure
RestartSec=5
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
