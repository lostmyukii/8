#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:-}
physical_world="/srv/maze/current/simulation/webots/maze_car/worlds/maze_physical_world.wbt"
if [[ ${mode} != status && ! -r ${physical_world} ]]; then
  echo "Physical Webots world is missing: ${physical_world}" >&2
  exit 1
fi
case "${mode}" in
  stream)
    systemctl stop maze-webots-desktop.service maze-webots-headless.service
    systemctl start maze-webots-stream.service
    systemctl restart maze-dashboard.service
    ;;
  desktop)
    systemctl stop maze-webots-stream.service maze-webots-headless.service
    systemctl start maze-vnc.service maze-novnc.service maze-webots-desktop.service
    systemctl restart maze-dashboard.service
    ;;
  headless)
    systemctl stop maze-webots-stream.service maze-webots-desktop.service
    systemctl start maze-webots-headless.service
    systemctl restart maze-dashboard.service
    ;;
  status)
    echo "Release: $(readlink -f /srv/maze/current)"
    echo "Physical world: ${physical_world}"
    echo "Default profile: normal-v1"
    systemctl --no-pager --full status \
      maze-dashboard.service \
      maze-webots-stream.service \
      maze-webots-desktop.service \
      maze-webots-headless.service \
      maze-vnc.service \
      maze-novnc.service || true
    ;;
  *)
    echo "Usage: maze-sim-mode {stream|desktop|headless|status}" >&2
    exit 2
    ;;
esac
