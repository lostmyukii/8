# Copy to /etc/maze-agent/maze-agent.env and set mode 0600.
# Never commit the issued device token or the resolved serial device path.
MAZE_AGENT_SERVER_URL=wss://your-domain.example/ws/agents/your-device-id
MAZE_AGENT_DEVICE_ID=your-device-id
MAZE_AGENT_DEVICE_TOKEN=replace-with-one-time-issued-token
MAZE_AGENT_SERIAL_PORT=replace-with-local-stable-serial-path
MAZE_AGENT_SERIAL_BAUD=115200
MAZE_AGENT_SERIAL_TIMEOUT_S=3
